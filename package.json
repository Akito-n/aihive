{
  "name": "aihive",
  "version": "0.3.0",
  "type": "module",
  "description": "tmux + Claude Code multi-agent orchestration system with React Ink TUI",
  "bin": {
    "aihive": "./dist/bin/aihive.js"
  },
  "scripts": {
    "prepack": "tsc",
    "build": "tsc",
    "dev": "tsx src/bin/aihive.tsx",
    "start": "node dist/bin/aihive.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "biome check src/",
    "check:fix": "biome check --write src/",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist/",
    "instructions/"
  ],
  "keywords": [
    "claude",
    "multi-agent",
    "tmux",
    "orchestration",
    "react-ink",
    "tui"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "sql.js": "^1.15.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
